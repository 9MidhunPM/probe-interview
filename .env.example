OPENAI_API_KEY=
OPENAI_ORCHESTRATOR_MODEL=gpt-5.6-luna
OPENAI_REASONING_MODEL=gpt-4.1-mini
OPENAI_EXTRACTION_MODEL=gpt-4o-mini
OPENAI_MAX_RETRIES=2
OPENAI_RETRY_BASE_SECONDS=0.5

# Optional manual fallbacks. All default traffic uses OpenAI.
ORCHESTRATOR_PROVIDER=openai
REASONING_PROVIDER=openai
EXTRACTION_PROVIDER=openai
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

MAX_TURNS=14
MAX_MESSAGE_CHARS=2000
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_NEW_SESSIONS_PER_HOUR=10

ACCESS_PASSWORD=INTERVIEWMASTER
ACCESS_MAX_ATTEMPTS=5
ACCESS_COOLDOWN_MINUTES=10
ACCESS_SESSION_HOURS=12
ACCESS_COOKIE_SECURE=false
